{
  "name": "sinapse-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "App v1 do segundo cérebro — lê o vault markdown e mostra o grafo gamificado do conhecimento.",
  "scripts": {
    "index": "node scripts/index-vault.mjs",
    "dev": "npm run index && vite",
    "build": "npm run index && vite build",
    "preview": "vite preview",
    "reindex": "node scripts/index-vault.mjs",
    "test": "node --test src/lib/financeiroGraficos.test.ts src/lib/financeiroAnalise.test.ts src/lib/financeiroModelo.test.ts scripts/financas/financas.test.mjs scripts/destinos-desenhos.test.mjs",
    "financas:testar": "node scripts/financas/sincronizar.mjs --testar",
    "financas:simular": "node scripts/financas/sincronizar.mjs --simular",
    "financas:gravar": "node scripts/financas/sincronizar.mjs --gravar"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.17.6",
    "d3": "^7.9.0",
    "marked": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "elkjs": "^0.9.3",
    "gray-matter": "^4.0.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
